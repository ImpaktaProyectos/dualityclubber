# Public (inlined into the client bundle at build time by Vite)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-only (also needed at BUILD time so SSR can reach Supabase locally;
# in Cloudflare Workers these come from `wrangler secret put`, not from .env)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
# SUPABASE_SERVICE_ROLE_KEY="set-only-locally-for-dev-never-commit"
# LOVABLE_API_KEY="optional-if-using-lovable-ai-gateway"
